# systemd-юніт для запуску ОголошенняUK без Docker.
#
# Встановлення:
#   sudo cp deploy/ogoloshennia.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ogoloshennia
#
# Логи:  journalctl -u ogoloshennia -f

[Unit]
Description=ОголошенняUK — дошка оголошень
After=network.target

[Service]
Type=simple
# Створіть користувача:  sudo useradd -r -s /usr/sbin/nologin ogoloshennia
User=ogoloshennia
WorkingDirectory=/opt/ogoloshennia
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

# Налаштування через оточення (відредагуйте під себе):
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=SITE_URL=https://example.com
Environment=ADMIN_EMAILS=you@example.com
# SMTP для листів (необов'язково):
# Environment=SMTP_HOST=smtp.example.com
# Environment=SMTP_PORT=587
# Environment=SMTP_USER=no-reply@example.com
# Environment=SMTP_PASS=secret
# Environment=MAIL_FROM=ОголошенняUK <no-reply@example.com>
# Платежі Stripe (необов'язково):
# Environment=STRIPE_SECRET_KEY=sk_live_xxx
# Environment=STRIPE_WEBHOOK_SECRET=whsec_xxx

# Базове посилення безпеки.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ogoloshennia/data /opt/ogoloshennia/public/uploads

[Install]
WantedBy=multi-user.target
